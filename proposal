<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contract Proposals | Local 710</title>
    <style>
        :root {
            --bg-main: #121212;
            --bg-card: #1e1e1e;
            --accent: #ffcc00;
            --text-main: #ffffff;
            --text-muted: #888;
            --border: #333;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg-main); color: var(--text-main); padding-bottom: 40px; }

        /* Top Navbar */
        .top-navbar {
            height: 70px; background: #1a1a1a; border-bottom: 2px solid var(--accent);
            display: flex; align-items: center; padding: 0 20px; position: sticky; top: 0; z-index: 1000;
        }
        .header-title { font-size: 18px; font-weight: bold; letter-spacing: 0.5px; }
        .header-sub { font-size: 13px; color: var(--accent); margin-top: 2px; font-weight: 500; }
        
        .back-btn {
            background: none; border: none; color: var(--accent); 
            font-size: 24px; cursor: pointer; margin-right: 15px; text-decoration: none; display: flex; align-items: center; justify-content: center;
        }

        /* Form Container */
        .form-container { padding: 20px; max-width: 800px; margin: 0 auto; }
        
        .form-header {
            background: #262626; border-left: 5px solid var(--accent); padding: 15px 20px;
            border-radius: 6px; margin-bottom: 25px; box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .form-header h2 { font-size: 16px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
        .form-header p { font-size: 13px; color: var(--text-muted); }

        /* Form Sections */
        .form-section {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
            padding: 20px; margin-bottom: 20px;
        }
        .section-title { font-size: 14px; font-weight: 800; color: var(--accent); margin-bottom: 15px; text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 8px; }

        /* Inputs */
        .input-group { margin-bottom: 15px; }
        label { display: block; font-size: 12px; font-weight: bold; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; }
        input[type="text"], input[type="email"], textarea {
            width: 100%; background: #121212; border: 1px solid #444; color: white;
            padding: 12px; border-radius: 6px; font-size: 15px; outline: none; transition: border-color 0.2s;
        }
        input[type="text"]:focus, input[type="email"]:focus, textarea:focus { border-color: var(--accent); }
        textarea { resize: vertical; min-height: 100px; }

        /* Radio & Checkboxes */
        .radio-group { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 5px; }
        .radio-label {
            display: flex; align-items: center; gap: 8px; font-size: 14px; color: #e0e0e0;
            background: #2a2a2a; padding: 10px 15px; border-radius: 6px; border: 1px solid #444; cursor: pointer;
        }
        .radio-label input { accent-color: var(--accent); width: 16px; height: 16px; cursor: pointer; }

        /* Submit Button */
        .btn-submit {
            width: 100%; background: var(--accent); color: #000; font-size: 16px; font-weight: 900;
            text-transform: uppercase; padding: 16px; border: none; border-radius: 8px; cursor: pointer;
            box-shadow: 0 4px 0 #b38f00; transition: all 0.1s; margin-top: 10px;
        }
        .btn-submit:active { transform: translateY(3px); box-shadow: 0 1px 0 #b38f00; }
        .btn-submit:disabled { background: #555; color: #888; box-shadow: none; cursor: not-allowed; }

        /* Success Message */
        #success-msg {
            display: none; background: #2ecc71; color: #000; padding: 20px; border-radius: 8px;
            text-align: center; font-weight: bold; margin-top: 20px;
        }
    </style>
</head>
<body>

    <div class="top-navbar">
        <a href="javascript:history.back()" class="back-btn">←</a>
        <div>
            <div class="header-title">Local 710 Proposals</div>
            <div class="header-sub">UPS Contract Negotiations</div>
        </div>
    </div>

    <div class="form-container">
        
        <div class="form-header">
            <h2>Contract Proposal Form</h2>
            <p>Submit your contract proposals directly to Local 710. Submissions will be reviewed by your Union Stewards and Business Agents.</p>
        </div>

        <form id="proposal-form">
            
            <div class="form-section">
                <div class="section-title">1. Member Information</div>
                
                <div class="input-group">
                    <label>Full Name</label>
                    <input type="text" id="member-name" required placeholder="Jane Doe">
                </div>
                
                <div class="input-group">
                    <label>Job Classification</label>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="classification" value="Feeder Driver" required> Feeder</label>
                        <label class="radio-label"><input type="radio" name="classification" value="Package Car Driver"> Package</label>
                        <label class="radio-label"><input type="radio" name="classification" value="Inside / Hub"> Inside/Hub</label>
                        <label class="radio-label"><input type="radio" name="classification" value="Other"> Other</label>
                    </div>
                </div>

                <div class="input-group" style="margin-top: 20px;">
                    <label>Email Address</label>
                    <input type="email" id="member-email" placeholder="Optional, for bargaining updates">
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">2. Contract Proposals</div>
                <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 15px;">List the Article/Section number if known, followed by your proposed change or addition.</p>

                <div class="input-group">
                    <label>Contract Article / Section (If Applicable)</label>
                    <input type="text" id="article-1" placeholder="e.g., Article 26, Section 1">
                </div>
                <div class="input-group">
                    <label>Your Proposal</label>
                    <textarea id="proposal-1" required placeholder="Explain your proposed change here..."></textarea>
                </div>

                <hr style="border: 0; border-top: 1px dashed #444; margin: 25px 0;">

                <div class="input-group">
                    <label>Contract Article / Section (Optional)</label>
                    <input type="text" id="article-2">
                </div>
                <div class="input-group">
                    <label>Your Proposal</label>
                    <textarea id="proposal-2" placeholder="Second proposal..."></textarea>
                </div>

            </div>

            <button type="submit" id="submit-btn" class="btn-submit">Submit Proposals</button>
            
            <div id="success-msg">
                ✅ Proposal Submitted Successfully! <br><span style="font-size: 13px; font-weight: normal;">Thank you for participating in the process.</span>
            </div>
        </form>

    </div>

    <script>
        document.getElementById('proposal-form').addEventListener('submit', function(e) {
            e.preventDefault(); // Stop the page from reloading
            
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.innerText = "Sending...";
            submitBtn.disabled = true;

            // 1. Gather all the data from the form
            const formData = {
                name: document.getElementById('member-name').value,
                classification: document.querySelector('input[name="classification"]:checked').value,
                email: document.getElementById('member-email').value,
                proposals: [
                    {
                        article: document.getElementById('article-1').value,
                        text: document.getElementById('proposal-1').value
                    },
                    {
                        article: document.getElementById('article-2').value,
                        text: document.getElementById('proposal-2').value
                    }
                ]
            };

            // 2. The Power Automate Handoff (This is where the magic will happen later)
            // For now, we will simulate the delay of sending it to the server
            console.log("Payload ready to send:", formData);
            
            setTimeout(() => {
                // Hide the form and show the success message
                document.getElementById('proposal-form').reset();
                document.getElementById('submit-btn').style.display = 'none';
                document.getElementById('success-msg').style.display = 'block';
            }, 1500);

            /* WHEN YOU BUILD YOUR POWER AUTOMATE FLOW, YOU WILL REPLACE THE SETTIMEOUT ABOVE WITH THIS:
            
            fetch('YOUR_POWER_AUTOMATE_URL_HERE', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            }).then(response => {
                document.getElementById('proposal-form').reset();
                document.getElementById('submit-btn').style.display = 'none';
                document.getElementById('success-msg').style.display = 'block';
            }).catch(error => {
                submitBtn.innerText = "Error. Try Again.";
                submitBtn.disabled = false;
            });
            */
        });
    </script>
</body>
</html>
